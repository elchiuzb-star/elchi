<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window before Compose draws; every screen is themed in Compose (ui/theme). -->
    <style name="Theme.Elchi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/elchi_background</item>
    </style>
    <style name="Theme.Elchi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/elchi_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Elchi</item>
    </style>
</resources>
