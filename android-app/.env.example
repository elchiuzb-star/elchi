# Base URL of the deployed Elchi backend API (must be HTTPS for on-device use).
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app bundle.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Google Maps key (used later for pickup/dropoff picker & order maps).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
