# App env file for api and worker (BR wave 1.6 N2). On the server:
#   cp app.env.example .env.app && chmod 600 .env.app
# .env.app is gitignored. It is ALSO the only --env-file compose uses for ${...} interpolation.
#
# NEVER put database admin credentials here: POSTGRES_PASSWORD, ELCHI_DB_OWNER_PASSWORD,
# ELCHI_MIGRATION_DATABASE_URL, ELCHI_DB_ADMIN_URL live only in .env.db-admin
# (db-admin.env.example). scripts/deploy.sh refuses to deploy if any of them is here.

# ── Images (Q51) ──────────────────────────────────────────────────────────────
# Prebuilt PostGIS image in the private registry in Uzbekistan, pinned by digest.
# Build and push once: docs/ops/POSTGRES_POSTGIS_MIGRATION.md §2.1. Production refuses a tag without digest.
ELCHI_REGISTRY=<registry.your-domain.uz/elchi>
ELCHI_POSTGIS_IMAGE=<registry.your-domain.uz/elchi>/elchi-postgis@sha256:<64-hex-digest>

# ── Deployment identity (docs/ops/UZ_HOSTING_RUNBOOK.md) ──────────────────────
ELCHI_DOMAIN=<api.your-domain.uz>
# Set to UZ ONLY after the hosting, registry and backup locations were verified in Uzbekistan (K3).
ELCHI_DATA_RESIDENCY=<UZ after verification>
# Space-separated CIDRs of the monitoring sources allowed to read /health/ready at Caddy (decision 33).
# Empty = nobody. 0.0.0.0/0 and ::/0 are refused by scripts/deploy.sh.
ELCHI_MONITORING_CIDRS=<monitoring-ip>/32

# ── App ──────────────────────────────────────────────────────────────────────
ELCHI_APP_NAME=Elchi API
# One of: production | staging | development | test | local. Must match the database marker.
ELCHI_ENVIRONMENT=production
ELCHI_DEBUG=false
ELCHI_API_V1_PREFIX=/api/v1
ELCHI_LOG_LEVEL=INFO

# App role only (NOSUPERUSER, DML). Password = ELCHI_DB_APP_PASSWORD in .env.db-admin (hex).
ELCHI_DATABASE_URL=postgresql+psycopg://elchi_app:<same-as-ELCHI_DB_APP_PASSWORD>@db:5432/elchi
ELCHI_DB_APP_USER=elchi_app
ELCHI_DB_OWNER_USER=elchi_owner

# ── Redis (non-durable, ADR-0012); hex password, embedded in the URL ──────────
REDIS_PASSWORD=<openssl rand -hex 32>
ELCHI_REDIS_URL=redis://:<same-as-REDIS_PASSWORD>@redis:6379/0

# ── Postgres tuning and archiving (interpolated into the db service; not secrets) ──
PG_MEMORY_LIMIT=2g
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MAX_CONNECTIONS=100
# MUST stay off in production (decision 35, no override).
PG_ARCHIVE_MODE=off
PG_ARCHIVE_TIMEOUT=300

# ── Auth / keys (docs/ops/SECRET_ROTATION.md) ─────────────────────────────────
ELCHI_SECRET_KEY=<openssl rand -hex 32>
# Previous master(s), comma-separated, newest first; kept 48 h after a rotation, then removed.
ELCHI_PREVIOUS_SECRET_KEYS=
ELCHI_PROOF_CODE_KEY=<openssl rand -hex 32>
ELCHI_CURSOR_SIGNING_KEY=<openssl rand -hex 32>
ELCHI_ACCESS_TOKEN_EXPIRE_MINUTES=60
ELCHI_REFRESH_TOKEN_EXPIRE_DAYS=30
ELCHI_JWT_ALGORITHM=HS256
ELCHI_SUPER_ADMIN_PHONE=+998900000001

# ── OTP ──────────────────────────────────────────────────────────────────────
ELCHI_OTP_LENGTH=4
ELCHI_OTP_EXPIRE_SECONDS=180
ELCHI_OTP_MAX_SEND_REQUESTS=5
ELCHI_OTP_SEND_WINDOW_MINUTES=30
ELCHI_OTP_RESEND_COOLDOWN_SECONDS=60
ELCHI_OTP_MAX_VERIFY_ATTEMPTS=5
ELCHI_OTP_MAX_REQUESTS_PER_IP=15
ELCHI_OTP_IP_WINDOW_MINUTES=60
ELCHI_OTP_GLOBAL_DAILY_CAP=2000

# ── App-store reviewer access ────────────────────────────────────────────────
# Before removing a phone: scripts/check_review_account_orders.py must exit 0 (Q39,
# docs/ops/SECRET_ROTATION.md §4). CLEAR BOTH once the app is approved.
ELCHI_REVIEW_LOGIN_PHONES=+998900000010,+998900000011
ELCHI_REVIEW_LOGIN_OTP=<any 4 digits>

# ── SMS (Eskiz.uz) ───────────────────────────────────────────────────────────
ELCHI_SMS_ENABLED=true
ELCHI_SMS_TEST_MODE=false
ELCHI_ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ELCHI_ESKIZ_EMAIL=<your eskiz account email>
ELCHI_ESKIZ_PASSWORD=<your eskiz api password>
ELCHI_ESKIZ_FROM=4546

# ── Uploads ──────────────────────────────────────────────────────────────────
ELCHI_UPLOAD_DIR=storage/uploads
ELCHI_MAX_IMAGE_UPLOAD_MB=5
ELCHI_MAX_DOCUMENT_UPLOAD_MB=10
ELCHI_PUBLIC_UPLOAD_BASE_URL=/uploads
ELCHI_FILE_URL_SIGNING_KEY=<openssl rand -hex 32>
ELCHI_FILE_URL_TTL_SECONDS=900

# ── Maps ─────────────────────────────────────────────────────────────────────
ELCHI_YANDEX_GEOCODER_API_KEY=<yandex geocoder key>
# Yandex Geosuggest - a separate product with its own key. The geocoder answers addresses; suggest answers
# place names ("10-sonli maktab"), which is what people type. Without it `/geo/suggest` returns an empty
# list and the map plus a draggable pin stay the way to mark a place. Data flow E10.
ELCHI_YANDEX_SUGGEST_API_KEY=<yandex geosuggest key>

# ── Geo routing (app/modules/geo/config.py) ──────────────────────────────────
# disabled in production until the legal/terms review (Q24/Q46; EXTERNAL_DATA_FLOWS.md E9).
ELCHI_GEO_ROUTING_PROVIDER=disabled
# `osrm` is our own router: a container beside the database serving an OpenStreetMap extract of
# Uzbekistan. Nothing leaves the machine, so it adds no external data flow - it is the option that can
# eventually lift decision 24, though doing so still needs an ADR and a code change, not this line.
# Prepare the graph once with scripts/osrm-prepare.sh, then start it with the `routing` compose profile.
ELCHI_GEO_OSRM_BASE_URL=http://127.0.0.1:5000
# Dev/test only: widen the Q88 projection radius (metres) so any two marked places resolve against the
# synthetic nationwide corridor (scripts/seed_dev_nationwide.py). Ignored outside development - see
# corridor_point_offset_m. Leave unset for realistic behaviour.
# ELCHI_GEO_DEV_POINT_OFFSET_M=400000
ELCHI_GEO_GEOAPIFY_API_KEY=
ELCHI_GEO_GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/routing
ELCHI_GEO_ROUTING_TIMEOUT_S=6
ELCHI_GEO_ROUTING_CACHE_TTL_S=86400

# ── Wave 3 services (A6 tracking, A12 support) ───────────────────────────────
# Recipient tracking link (K5); must contain {token}. Put the public web page in
# front of the API path when it exists, e.g. https://elchi.uz/t/{token}.
ELCHI_TRACKING_PUBLIC_URL_TEMPLATE=/api/v2/public/tracking/{token}
# S13 support contacts (U7). A real, answered number and honest opening hours;
# empty phone -> the app shows "not available" instead of a number nobody answers.
# An hours text that promises 24/7 or a response time is refused (§5.2, §16).
# Q87 (enforced since wave 7): in production `passenger_enabled` CANNOT be switched on while this is
# empty - the flag write is refused with `support_contact_not_configured`. Do not put a placeholder
# or an unanswered number here to get past it.
ELCHI_SUPPORT_PHONE=<+998 XX XXX XX XX>
ELCHI_SUPPORT_HOURS_TEXT=<e.g. Du-Sha 09:00-18:00>

# ── Growth (A13, wave 4) ─────────────────────────────────────────────────────
# Public share page of a listing (§20.2); must contain {token}. Point it at the public web page once it exists,
# e.g. https://elchi.uz/e/{token}; the API path works on its own until then.
ELCHI_SHARE_PUBLIC_URL_TEMPLATE=/api/v2/public/listings/{token}

# ── Worker job intervals (seconds; app/worker, wave 3.1) ─────────────────────
# Optional; unset uses the built-in defaults shown here. Clamped to [5, 86400].
ELCHI_WORKER_OUTBOX_INTERVAL_SECONDS=5
ELCHI_WORKER_PUSH_INTERVAL_SECONDS=10
ELCHI_WORKER_TRACKING_SIGNAL_INTERVAL_SECONDS=60
ELCHI_WORKER_TRACKING_RETENTION_INTERVAL_SECONDS=3600
ELCHI_WORKER_REPUTATION_INTERVAL_SECONDS=900
ELCHI_WORKER_KPI_INTERVAL_SECONDS=3600
ELCHI_WORKER_SHARE_LINK_INTERVAL_SECONDS=3600

# ── CORS ─────────────────────────────────────────────────────────────────────
ELCHI_CORS_ORIGINS=https://elchi.uz,https://www.elchi.uz,https://admin.elchigo.uz
ELCHI_CORS_ORIGIN_REGEX=https://elchi-[a-z0-9-]+\.vercel\.app
