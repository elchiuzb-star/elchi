            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{client_refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        }
