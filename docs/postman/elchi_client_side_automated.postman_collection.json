                  "  pm.expect(data.id).to.eql(Number(pm.environment.get('order_id')));",
                  "  pm.expect(data.status).to.eql('published');",
                  "  pm.expect(data.sender_phone).to.eql(pm.environment.get('sender_phone'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/client/orders/{{order_id}}"
          }
        },
        {
          "name": "List Published Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Published order appears in list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const items = pm.response.json().data.items || [];",
                  "  pm.expect(items.some(item => item.id === Number(pm.environment.get('order_id')))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/client/orders?status=published&page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "06 Client Cancellation Scenario",
      "item": [
        {
          "name": "Create Separate Draft For Cancellation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancellable draft created', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json().data || {};",
                  "pm.environment.set('cancel_order_id', data.id);",
                  "pm.environment.set('cancel_order_number', data.order_number);",
                  "pm.test('Cancellation order is draft', function () {",
                  "  pm.expect(data.status).to.eql('draft');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_city_id\": {{city_from_id}},\n  \"to_city_id\": {{city_to_id}},\n  \"pickup_address\": \"{{pickup_address}}\",\n  \"dropoff_address\": \"{{dropoff_address}}\",\n  \"sender_phone\": \"{{sender_phone}}\",\n  \"receiver_phone\": \"{{receiver_phone}}\",\n  \"cargo_photo_url\": \"{{cargo_photo_url}}\",\n  \"comment\": \"Cancellation scenario order\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/client/orders"
          }
        },
        {
          "name": "Cancel Own Draft Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client can cancel own draft', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.order_id).to.eql(Number(pm.environment.get('cancel_order_id')));",
                  "  pm.expect(data.status).to.eql('cancelled');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Client changed plans during automated test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/client/orders/{{cancel_order_id}}/cancel"
          }
        },
        {
          "name": "List Cancelled Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancelled order appears in list', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const items = pm.response.json().data.items || [];",
                  "  pm.expect(items.some(item => item.id === Number(pm.environment.get('cancel_order_id')))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/client/orders?status=cancelled&page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "07 Client Security And Validation",
      "item": [
        {
          "name": "Anonymous Cannot List Client Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Anonymous request is unauthorized', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/client/orders"
          }
        },
        {
          "name": "Refresh Token Cannot Access Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh token is rejected as access token', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_refresh_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Removed MVP Fields Are Rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Forbidden order fields are rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_city_id\": {{city_from_id}},\n  \"to_city_id\": {{city_to_id}},\n  \"pickup_address\": \"{{pickup_address}}\",\n  \"dropoff_address\": \"{{dropoff_address}}\",\n  \"sender_phone\": \"{{sender_phone}}\",\n  \"receiver_phone\": \"{{receiver_phone}}\",\n  \"cargo_photo_url\": \"{{cargo_photo_url}}\",\n  \"cargo_type\": \"documents\",\n  \"weight\": 3,\n  \"size\": \"small\",\n  \"pickup_time\": \"2026-06-16T10:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/client/orders"
          }
        }
      ]
    },
