# Database admin env file (BR wave 1.6 N2). On the server:
#   cp db-admin.env.example .env.db-admin && chmod 600 .env.db-admin
# .env.db-admin is gitignored and is given ONLY to the db service and the one-shot
# db-roles / migrate jobs (per-service env_file in docker-compose.prod.yml). api and worker
# never see it. It is not a compose --env-file (nothing here is interpolated).
#
# All passwords: hex only (openssl rand -hex 32); they are embedded in URLs.

# ── Bootstrap superuser (initdb, db-roles job, backups, emergency psql) ───────
# pg_hba rejects this user over TCP; it can log in only through the local socket.
POSTGRES_USER=elchi_admin
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=elchi
# db-roles connects through the socket volume shared with the db service (no password needed).
ELCHI_DB_ADMIN_URL=postgresql://elchi_admin@/elchi?host=/var/run/postgresql

# ── Owner role: owns the schema, runs migrations (decision 36) ────────────────
ELCHI_DB_OWNER_USER=elchi_owner
ELCHI_DB_OWNER_PASSWORD=<openssl rand -hex 32>
ELCHI_MIGRATION_DATABASE_URL=postgresql+psycopg://elchi_owner:<same-as-ELCHI_DB_OWNER_PASSWORD>@db:5432/elchi

# ── App role password (db-roles sets it; api/worker use it via ELCHI_DATABASE_URL in .env.app) ──
ELCHI_DB_APP_USER=elchi_app
ELCHI_DB_APP_PASSWORD=<openssl rand -hex 32>
