    "trackingShare.shareHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывший ссылку увидит направление, время и цену; ваше имя и телефон не показываются. Ничего не публикуется от вашего имени автоматически."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Havola ochgan odam yo'nalish, vaqt va narxni ko'radi; ismingiz va telefoningiz ko'rsatilmaydi. Hech narsa siz uchun avtomatik joylanmaydi."
          }
        }
      }
    },
    "trackingShare.shareTitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделиться объявлением"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "E'lonni ulashish"
          }
        }
      }
    },
    "trackingShare.trackingHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получатель ссылки видит только статус автомобиля и его последнее местоположение - без имени, телефона и адреса. Местоположение видно только во время поездки. Ссылка показывается только сейчас, один раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Havolani olgan odam faqat avtomobil holatini va oxirgi joylashuvini ko'radi - ism, telefon va manzilsiz. Joylashuv faqat safar davomida ko'rinadi. Havola faqat hozir bir marta ko'rsatiladi."
          }
        }
      }
    },
    "trackingShare.trackingTitle": {
      "extractionState": "manual",
