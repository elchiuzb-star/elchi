          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Operator «kelmadi» xabarini ko'rib chiqmoqda — shu vaqtda bronni faqat operator bekor qila oladi."
          }
        }
      }
    },
