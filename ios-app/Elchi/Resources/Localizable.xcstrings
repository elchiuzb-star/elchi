    "bookingCancel.refused.changed": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бронь тем временем изменилась. Посмотрите новое состояние и попробуйте снова."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bron shu orada o'zgargan. Yangi holatini ko'rib, qayta urinib ko'ring."
          }
