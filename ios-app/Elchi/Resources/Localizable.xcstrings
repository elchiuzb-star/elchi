          }
        }
      }
    },
    "driver.error.plateTaken": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот госномер уже закреплён за другим водителем. Проверьте номер или напишите оператору."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu davlat raqami boshqa haydovchiga biriktirilgan. Raqamni tekshiring yoki operatorga yozing."
          }
        }
      }
    },
    "driver.faq1Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После проверки профиля и документов включите статус «на линии». Подходящие вашему направлению запросы появятся в разделе «Подходящие»: соглашайтесь с ценой клиента или предлагайте свою."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil va hujjatlaringiz tasdiqlangach, faol holatni yoqing. Yo'nalishingizga mos so'rovlar «Moslar» bo'limida ko'rinadi: mijoz narxiga rozi bo'lasiz yoki o'z narxingizni taklif qilasiz."
          }
        }
      }
    },
    "driver.faq1Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как получать заказы?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyurtmalarni qanday olaman?"
          }
        }
      }
    },
    "driver.faq2Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиент платит вам наличными. Комиссия ELCHI удерживается с предоплаченного баланса кошелька при принятии брони и списывается после завершения услуги."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijoz sizga naqd to'laydi. ELCHI komissiyasi bron qabul qilinganda hamyoningizdagi oldindan to'ldirilgan balansdan ushlab turiladi va xizmat yakunlanganda undiriladi."
          }
        }
      }
    },
    "driver.faq2Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как списывается комиссия?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Komissiya qanday olinadi?"
          }
        }
      }
    },
    "driver.faq3Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные автомобиля вводятся один раз. Если нужно их изменить, обратитесь к оператору или администратору."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomobil ma'lumotlari bir marta kiritiladi. O'zgartirish kerak bo'lsa, operator yoki adminga murojaat qiling."
          }
        }
      }
    },
    "driver.faq3Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как изменить данные автомобиля?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomobil ma'lumotlarini qanday o'zgartiraman?"
          }
        }
      }
    },
    "driver.faq4Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда начинается услуга: для посылок — когда рейс отправляется. До этого связь только через чат в приложении."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xizmat boshlanganda: pochta uchun safar yo'lga chiqqanda. Undan oldin aloqa ilova ichidagi chat orqali bo'ladi."
          }
        }
      }
    },
    "driver.faq4Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда открывается телефон клиента?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijozning telefoni qachon ochiladi?"
          }
        }
      }
    },
