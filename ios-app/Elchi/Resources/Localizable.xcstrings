    "driverTracking.noWakeLock": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран может погаснуть сам - увеличьте время отключения экрана в настройках телефона."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran o'zi o'chib qolishi mumkin - telefon sozlamalarida ekran o'chish vaqtini uzaytiring."
          }
        }
      }
    },
    "driverTracking.permissionDenied": {
