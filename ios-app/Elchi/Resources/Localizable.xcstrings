    "promoScreen.bonusNotMoney": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонус — право на скидку при следующей подходящей услуге. Это не деньги: его нельзя обналичить или передать другому."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus — keyingi mos xizmatdagi chegirma huquqi. U pul emas: naqd qilib olinmaydi va boshqaga o'tkazilmaydi."
          }
        }
      }
    },
    "promoScreen.clientCovers": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидку покрывает ELCHI. Водителю вы отдаёте только сумму наличными, указанную ниже."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegirmani ELCHI qoplaydi. Haydovchiga faqat pastdagi naqd summani berasiz."
          }
        }
      }
    },
    "promoScreen.codeAccepted": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
