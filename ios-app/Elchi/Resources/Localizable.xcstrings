    "addRoute.noApprovedRoute": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом направлении нет утверждённого маршрута — его должен добавить оператор."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yo'nalishda tasdiqlangan marshrut yo'q — operator marshrut qo'shishi kerak."
          }
        }
      }
    },
    "addRoute.noApprovedVehicle": {
      "extractionState": "manual",
      "localizations": {
