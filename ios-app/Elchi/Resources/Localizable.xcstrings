    "offerCreate.startingPriceNote": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваша стартовая цена. Клиент предложит свою, вы отправите встречное предложение. Бронь создаётся только после того, как вы оба договоритесь; объявление не занимает места и не блокирует баланс."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu — boshlang'ich narxingiz. Mijoz o'z narxini taklif qiladi, siz qarshi taklif yuborasiz. Bron faqat ikkalangiz kelishgandan keyin yaratiladi; e'lon o'rin yoki balansni band qilmaydi."
          }
        }
      }
    },
