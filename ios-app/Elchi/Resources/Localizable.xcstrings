      }
    },
    "promo.disclosure.milestoneUnit": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый этап — отдельная поездка (несколько заказов в одной поездке — один этап)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bosqich — alohida safar (bir safardagi bir nechta buyurtma bitta bosqich)."
