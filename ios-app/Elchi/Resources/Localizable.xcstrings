          }
        }
      }
    },
    "promo.disclosure.nextEligibleService": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вознаграждение дают не за регистрацию, а после услуги, соответствующей условиям."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukofot ro'yxatdan o'tganingiz uchun emas — shartlarga mos xizmatdan keyin beriladi."
          }
        }
      }
    },
    "promo.disclosure.notCash": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонус — не деньги, а только скидка на следующую услугу. Его нельзя обналичить или передать другому."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus pul emas: u faqat keyingi xizmatdagi chegirma. Naqdga aylantirilmaydi va boshqaga o'tkazilmaydi."
          }
        }
      }
    },
    "promo.disclosure.qualificationDeadline": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок выполнения условия: {duration}."
