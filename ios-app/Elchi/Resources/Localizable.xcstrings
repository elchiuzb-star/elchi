            "value": "Ваш аккаунт заблокирован. Напишите в поддержку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisobingiz bloklangan. Qo'llab-quvvatlashga yozing."
          }
        }
      }
