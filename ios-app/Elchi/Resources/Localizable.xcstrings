    "bookingCancel.refused.custody": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Груз уже у водителя — вместо отмены нужен возврат. Напишите в поддержку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuk allaqachon haydovchida — bekor qilish o'rniga qaytarish jarayoni kerak. Qo'llab-quvvatlashga yozing."
          }
        }
      }
    },
    "bookingCancel.refused.noShowPending": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить нельзя: оператор рассматривает сообщение о неявке. До решения бронь отменяет только оператор."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekor qilib bo'lmadi: operator «kelmadi» xabarini ko'rib chiqmoqda. Qaror chiqquncha bronni faqat operator bekor qiladi."
          }
        }
      }
    },
    "bookingCancel.refused.tooLate": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Услуга уже началась — отменить бронь нельзя. Если есть проблема, откройте спор."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xizmat boshlangan — endi bronni bekor qilib bo'lmaydi. Muammo bo'lsa, nizo oching."
          }
        }
      }
    },
    "bookingCancel.reviewPending": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
