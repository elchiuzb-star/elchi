    "driver.booking.inTransitNote": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Водитель в пути. Доставку или возврат посылки отмечает оператор — код и подтверждение не нужны."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haydovchi yo'lga chiqdi. Jo'natma yetkazilgani yoki qaytarilishini operator qayd etadi — kod va tasdiq kerak emas."
          }
        }
      }
    },
