            "state": "translated",
            "value": "Boshlash"
          }
        }
      }
    },
    "onboarding.step1Text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите направление, укажите адреса и получите предложения от водителей."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo'nalishni tanlang, manzillarni kiriting va haydovchilardan taklif oling."
          }
        }
      }
    },
    "onboarding.step1Title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте посылки из города в город"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Posilkangizni shahardan shaharga yuboring"
          }
        }
      }
    },
    "onboarding.step2Text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящую цену и водителя вы выбираете сами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizga mos narx va haydovchini o'zingiz tanlaysiz."
          }
        }
      }
    },
    "onboarding.step2Title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Водители предлагают цену"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haydovchilar narx taklif qiladi"
          }
        }
      }
    },
    "onboarding.step3OperatorText": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После договорённости открываются чат и отслеживание. Оплата — наличными водителю."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelishuvdan keyin chat va kuzatuv ochiladi. To'lov haydovchiga naqd beriladi."
          }
        }
      }
    },
    "onboarding.step3OperatorTitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставку фиксирует оператор"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetkazilganini operator qayd etadi"
          }
        }
      }
    },
    "onboarding.step3Text": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда посылка доставлена, подтвердите заказ и оцените водителя."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Posilka yetib borgach, buyurtmani tasdiqlang va haydovchiga baho bering."
          }
        }
      }
    },
    "onboarding.step3Title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставлено - подтвердите и оцените"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetkazildi - tasdiqlang va baholang"
          }
        }
      }
    },
    "onboarding.tagline": {
      "extractionState": "manual",
