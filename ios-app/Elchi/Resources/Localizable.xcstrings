    "promo.amendment.cashChanges": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма к оплате наличными изменится — проверьте перед подтверждением."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Naqd to'lanadigan summa o'zgaradi — tasdiqlashdan oldin tekshiring."
          }
        }
      }
    },
    "promo.amendment.cashRisesDespiteLowerFare": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание: хотя цена снизилась, ваша оплата наличными вырастет — бонусная скидка зависит от цены и тоже уменьшилась."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Diqqat: narx kamaygan bo'lsa ham, naqd to'lovingiz oshadi — bonus chegirmasi narxga bog'liq bo'lib, u ham kamaydi."
          }
        }
      }
    },
    "promo.amendment.discountAlsoSmaller": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена снизилась, но бонусная скидка тоже уменьшилась — поэтому сумма наличных снижается меньше, чем цена."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narx kamaydi, lekin bonus chegirmasi ham kamaydi — shuning uchun naqd summa narxdan kamroq kamayadi."
          }
        }
      }
    },
    "promo.amendment.fareRose": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена выросла. Бонусная скидка не увеличится: при изменении новый бонус не используется."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narx oshdi. Bonus chegirmasi oshmaydi: o'zgarishda yangi bonus ishlatilmaydi."
          }
        }
      }
    },
