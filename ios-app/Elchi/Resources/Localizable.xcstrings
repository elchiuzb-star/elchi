        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo'lkira haydovchiga naqd beriladi. Bu yerda faqat qayd qoladi — ELCHI bu pulni qabul qilmaydi."
          }
        }
      }
    },
