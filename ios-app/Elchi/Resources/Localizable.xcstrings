    "onboarding.roleSubtitlePermanent": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роль привязывается к номеру телефона. Для другой роли нужно выйти и войти заново."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rol telefon raqamingizga bog'lanadi. Boshqa rol uchun chiqib, qayta kirasiz."
          }
        }
      }
    },
