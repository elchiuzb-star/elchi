    "driverTracking.foregroundOnly": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение передаётся, только пока приложение открыто и экран включён."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joylashuv faqat ilova ochiq va ekran yoniq turganda yuboriladi."
          }
        }
      }
    },
    "driverTracking.gapBackground": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{from}-{to}: экран был заблокирован или приложение в фоне - в этот промежуток местоположение не записано"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "{from}-{to}: ekran qulflangan yoki ilova fonda edi - bu oraliqda joylashuv yozilmadi"
          }
        }
      }
    },
    "driverTracking.gapNoFix": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{from}-{to}: телефон не давал местоположение (GPS выключен или энергосбережение) - трека в этот промежуток нет"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "{from}-{to}: telefon joylashuv bermadi (GPS o'chiq yoki batareya tejash rejimi) - bu oraliqda yo'l izi yo'q"
          }
        }
      }
    },
    "driverTracking.hidden": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение в фоне: браузер может остановить геолокацию. Оставьте приложение открытым."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova fonda: brauzer joylashuvni to'xtatishi mumkin. Ilovani ochiq qoldiring."
          }
        }
      }
    },
    "driverTracking.idle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение не передаётся"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Joylashuv yuborilmayapti"
          }
        }
      }
    },
    "driverTracking.idleHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка началась. Включите передачу местоположения, чтобы клиенты видели автомобиль на карте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Safar boshlandi. Mijozlar avtomobilni xaritada ko'rishi uchun joylashuvni yuborishni yoqing."
          }
        }
      }
    },
    "driverTracking.insecure": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница открыта не по защищённому адресу (HTTPS) - браузер не даёт местоположение"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahifa xavfsiz (HTTPS) manzilda ochilmagan - brauzer joylashuvni bermaydi"
          }
        }
      }
    },
