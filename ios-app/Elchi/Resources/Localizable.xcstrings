    "client.safety.note": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите об опасном поведении, подозрении на мошенничество или склонении к связи вне приложения — или заблокируйте этого человека. С обычной проблемой пишите в чат «Помощь / жалоба». Обязательства по брони сохраняются."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xavfli xatti-harakat, firibgarlik shubhasi yoki ilovadan tashqari aloqaga undash haqida xabar bering yoki bu odamni bloklang. Oddiy muammo uchun «Yordam / shikoyat» chatidan foydalaning. Bron majburiyatlari davom etadi."
          }
        }
      }
    },
