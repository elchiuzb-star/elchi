    "promo.disclosure.referrerServiceExcluded": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Услуга, выполненная самим пригласившим вас водителем, не засчитывается."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizni taklif qilgan haydovchining o'zi bajargan xizmat hisoblanmaydi."
          }
        }
      }
