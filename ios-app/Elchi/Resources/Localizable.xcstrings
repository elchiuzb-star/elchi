    "addRoute.plannedOnApprovedRoute": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка планируется по маршруту, утверждённому оператором. Если не указать место для груза, предложения на посылки не поступят."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Safar operator tasdiqlagan marshrut bo'yicha rejalashtiriladi. Yuk uchun joy ko'rsatilmasa, posilka takliflari yuborilmaydi."
          }
        }
      }
    },
