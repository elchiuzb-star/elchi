    "safety.sectionHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите об опасном поведении, подозрении на мошенничество или попытке связаться вне приложения либо заблокируйте этого человека. С обычной проблемой пишите в чат «Помощь / жалоба» выше. Обязательства по брони сохраняются."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xavfli xatti-harakat, firibgarlik shubhasi yoki ilovadan tashqari aloqaga undash haqida xabar bering yoki bu odamni bloklang. Oddiy muammo uchun yuqoridagi «Yordam / shikoyat» chatidan foydalaning. Bron majburiyatlari davom etadi."
          }
        }
      }
