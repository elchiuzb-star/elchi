    "driver.feed.stopsNote": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадения посчитаны по подтверждённым остановкам. Отклонение от маршрута не учитывается — точное место встречи согласуете в чате брони."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosliklar tasdiqlangan bekatlar bo'yicha hisoblangan. Yo'ldan chetga chiqish hisoblanmagan — aniq uchrashuv joyini bron chatida kelishasiz."
          }
        }
      }
    },
