    "support.emptyThread": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите проблему своими словами - номер брони и маршрут оператор видит автоматически."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Muammoni o'z so'zingiz bilan yozing - bron raqami va yo'nalish operatorga avtomatik ko'rinadi."
          }
        }
      }
    },
    "support.faq1Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте на карте место отправки и доставки, затем разместите объявление со своей ценой или предложите цену на объявления водителей."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Olib ketish va yetkazish joyini xaritada belgilang, keyin o'z narxingiz bilan e'lon bering yoki haydovchilarning e'lonlariga narx taklif qiling."
          }
        }
      }
    },
    "support.faq1Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как создать заказ?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyurtma qanday yarataman?"
          }
        }
      }
    },
    "support.faq2Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цену согласуете вы и водитель. Вы предлагаете цену, водитель может сделать встречное предложение; последнее принятое предложение становится ценой брони. ELCHI сам цену не устанавливает."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narxni siz va haydovchi kelishasiz. Siz narx taklif qilasiz, haydovchi qarshi taklif berishi mumkin; qabul qilingan oxirgi taklif bron narxi bo'ladi. ELCHI narxni o'zi belgilamaydi."
          }
        }
      }
    },
    "support.faq2Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как определяется цена?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Narx qanday belgilanadi?"
          }
        }
      }
    },
    "support.faq3Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да. Пока предложение не принято, объявление можно закрыть в любой момент. После создания брони условия отмены указаны на странице брони."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha. Taklif qabul qilinmaguncha e'lonni istalgan vaqtda yopishingiz mumkin. Bron tuzilgandan keyin bekor qilish shartlari bron sahifasida ko'rsatiladi."
          }
        }
      }
    },
    "support.faq3Question": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли отменить заказ?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Buyurtmani bekor qilsam bo'ladimi?"
          }
        }
      }
    },
    "support.faq4Answer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда начнётся услуга: для пассажира - когда вы сядете в машину, для посылки - когда груз заберут. До этого связь идёт через чат в приложении."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xizmat boshlanganda: yo'lovchi uchun siz mashinaga chiqqanda, pochta uchun yuk olib ketilganda. Undan oldin aloqa ilova ichidagi chat orqali bo'ladi."
          }
        }
      }
    },
