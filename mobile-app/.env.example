VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_ENV=development

# SMS code length. Must equal the backend's ELCHI_OTP_LENGTH (this repo's .env ships 5).
VITE_OTP_LENGTH=5

# Local only: the code the dev backend always accepts (ELCHI_DEV_MOCK_OTP). Shown on the OTP screen in dev builds.
VITE_DEV_OTP=12345

# --- Yandex Maps -------------------------------------------------------------------------------------------
# The web client uses the Yandex Maps **JavaScript API v3** (api-maps.yandex.ru). "MapKit SDK" is the native
# Android/iOS library and does not apply to this build.
#
# JS API key - draws the map. Create it in the Yandex Cloud console ("JavaScript API and Geocoder API"), then
# **restrict it to the domains this app is served from**: it ships inside the browser bundle, so a domain
# restriction is the only thing standing between the key and someone else's site.
#
# Without it every map degrades to its text fallback (a stop list, an address, coordinates) - the app stays
# usable, it just has no map.
#
# There is deliberately no geocoder key here. Turning a pin into an address goes through our own backend
# (`/geo/reverse-geocode`, `/geo/geocode`), which holds `ELCHI_YANDEX_GEOCODER_API_KEY` server-side - one fewer
# key in the bundle, and the data flow stays the one EXTERNAL_DATA_FLOWS.md already documents.
VITE_YANDEX_MAPS_API_KEY=113dbff8-6db4-436f-a3c3-adc944f29dc2

# Which JavaScript API version to load: `2.1` (default) or `v3`. Yandex issues a key for one of them, and
# the wrong one fails closed with `403 Invalid api key` - the maps then show their text fallback. This
# account's key is a v2.1 key, so the default is `2.1`; set `v3` the day a v3 key exists. No other code
# changes: `src/components/maps/yandex.ts` carries one adapter per version behind the same interface.
VITE_YANDEX_MAPS_VERSION=2.1

# Map label language. `uz_UZ` where Yandex has Uzbek labels; `ru_RU` or `en_US` are the other options.
VITE_YANDEX_MAPS_LANG=uz_UZ

# Optional: the v2 base URL. Empty -> VITE_API_BASE_URL with /api/v1 swapped for /api/v2 on the same host.
VITE_API_V2_BASE_URL=
